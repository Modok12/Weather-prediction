# Paystack dashboard > Settings > API Keys & Webhooks. Paste your test secret key while testing.
PAYSTACK_SECRET_KEY=
# Plan codes from Paystack dashboard > Payments > Plans, comma separated (e.g. monthly,yearly)
PAYSTACK_PLAN_CODES=PLN_monthlyxxxxxx,PLN_yearlyxxxxxxx
# Any long random string; signs the access tokens kept in the browser.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=change-me
# Public address of this server; Paystack sends customers back here after paying
APP_URL=http://localhost:3000
PORT=3000
DATA_FILE=data/subscribers.json
